.venv/
__pycache__/
*.pyc
.pytest_cache/
.claude/

# large / regenerable artefacts
datasets/
models/
runs/
sim/webots/worlds/
sim/webots/textures/
*.pth
*.pt
*.ckpt
*.zip

# your own parts, builds and inventory (the Builder writes these)
config/parts/
config/builds/
config/inventory.yaml

# the OpenRouter key (never commit it)
config/llm.json

# the chat page: saved chats, its settings and saved test suites
runs/chats/
config/chat.json
config/cases/

# Wi-Fi name and password for the rover firmware (tools/flash.py copies them into a temp folder only)
config/wifi.json
firmware/**/wifi_secrets.h

# local Wi-Fi and secret settings for the rover firmware (never commit)
**/config.local.h
